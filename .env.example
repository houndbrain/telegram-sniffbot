# ── Required ──────────────────────────────────────────────────────────────────

# Create a bot with @BotFather on Telegram and paste the token it gives you.
# Treat it like a password: anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=

# A running HoundBrain instance. The bot only ever reads from this address —
# it never contacts a market source itself, so there is no second collector and
# no second set of upstream credentials to manage.
HOUND_API_URL=


# ── Optional ──────────────────────────────────────────────────────────────────

# Public site, used for the "Open in browser" button on a specimen card.
# Leave empty and the button is simply not shown.
# HOUND_SITE_URL=https://houndbrain.xyz

# A group chat can produce many identical requests in one second. These collapse
# them without ever serving something older than one refresh of the instance.
# HOUND_API_CACHE_TTL_MS=8000
# HOUND_PANEL_CACHE_TTL_MS=60000
# HOUND_API_TIMEOUT_MS=12000

# Minimum gap between one chat's commands. A shared bot in a busy group is
# otherwise an easy way to hammer the instance behind it.
# HOUND_CHAT_INTERVAL_MS=900

# How much fits on a phone screen before a message stops being readable.
# HOUND_LIST_LIMIT=8
# HOUND_THESIS_LIMIT=5
# HOUND_HOLDER_LIMIT=8
# HOUND_TRADER_LIMIT=8
